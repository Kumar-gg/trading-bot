# Rename to fly.toml and run: fly launch / fly volumes create trading_bot_data
app = "your-trading-bot"
primary_region = "sin"

[build]
  dockerfile = "backend/Dockerfile"

[env]
  TB_DATABASE_URL = "sqlite+aiosqlite:///./data/trading_bot.db"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

[[mounts]]
  source = "trading_bot_data"
  destination = "/app/data"
