[Unit]
Description=Trading Bot paper trading API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/trading-bot/backend
EnvironmentFile=-/opt/trading-bot/backend/.env
Environment=TB_DATABASE_URL=sqlite+aiosqlite:///./data/trading_bot.db
ExecStart=/opt/trading-bot/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
